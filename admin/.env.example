# Copy this file to .env and fill in the same Supabase values as the other apps (Settings -> API Keys).
# Use the publishable key (sb_publishable_...). Never the secret/service_role key, not even here:
# the admin panel gets its extra powers from your admin account, not from a special key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
