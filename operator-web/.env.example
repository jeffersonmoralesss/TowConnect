# Copy this file to .env and fill in your Supabase project values (Settings -> API Keys).
# Use the publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The iCloud link to the "Tow Connect Check-in" shortcut, once you've built and shared it
# (README: "Build the check-in shortcut"). Leave empty until then.
VITE_CHECKIN_SHORTCUT_URL=
