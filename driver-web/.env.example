# Copy this file to .env and fill in your Supabase project values (Settings -> API Keys).
# Leave them empty to run in demo mode with sample operators.
# Use the publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: a different map style. Defaults to free OpenFreeMap tiles (no key needed).
# For Mapbox: https://api.mapbox.com/styles/v1/mapbox/streets-v12?access_token=YOUR_TOKEN
VITE_MAP_STYLE_URL=
