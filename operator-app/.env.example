# Copy this file to .env and fill in your Supabase project values (Project Settings -> API Keys).
# The EXPO_PUBLIC_ prefix tells Expo it's safe to build these into the app; never put a secret key here.
# Use the publishable key (sb_publishable_...) or the legacy anon key. Never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
